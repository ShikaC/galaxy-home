{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "银河居所",
  "version": "0.1.0",
  "identifier": "app.galaxyhome.desktop",
  "build": {
    "frontendDist": "http://127.0.0.1:4177",
    "devUrl": "http://127.0.0.1:5180",
    "beforeDevCommand": "node scripts/desktop-dev.mjs",
    "beforeBuildCommand": "node scripts/desktop-build.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "银河居所",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "installerHooks": "nsis-hooks.nsh"
      }
    },
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/app"
    ]
  }
}
